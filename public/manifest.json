{
  "manifest_version": 3,
  "name": "TabSpace",
  "short_name": "TabSpace",
  "version": "0.1.2",
  "description": "Organize and manage your open tabs in focused spaces.",
  "homepage_url": "https://github.com/nanasis/TabSpace",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "Open TabSpace",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ]
}
